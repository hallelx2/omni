{
  "name": "@omni/cli",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "omni": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "start": "bun run src/bin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omni/core": "workspace:*",
    "@omni/adapters": "workspace:*",
    "@omni/tools": "workspace:*",
    "@omni/storage": "workspace:*",
    "@omni/improve": "workspace:*",
    "ulid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
