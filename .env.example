# Pick one provider + set its key/URL. The CLI reads .env explicitly.

# MiMo (Xiaomi) — Token Plan
# MIMO_API_KEY=tp-...
# MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# MIMO_BASE_URL_ANTHROPIC=https://token-plan-sgp.xiaomimimo.com/anthropic/v1

# Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Google
# GOOGLE_API_KEY=...

# Which adapter the CLI picks (mock | mimo | mimo-anthropic | ollama | anthropic | openai | google)
# OMNI_ADAPTER=mimo
# OMNI_MODEL=mimo-v2.5-pro

# Optional: where to persist sessions/events/audit
# OMNI_DB=.omni/db.sqlite

# Optional: write JSONL traces to a directory
# OMNI_TRACES=.omni/traces

# Server (HTTP/WS)
# OMNI_SERVER_PORT=8088
# OMNI_SERVER_TOKEN=optional-bearer-token

# Web dev server
# OMNI_WEB_PORT=3000
